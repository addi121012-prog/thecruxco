---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { getCategory } from '../../config/categories';

const reviews = (await getCollection('reviews', (r) => !r.data.draft))
  .sort((a, b) => +(b.data.updatedDate ?? b.data.pubDate) - +(a.data.updatedDate ?? a.data.pubDate));
const fmt = (d: Date) => new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---
<Base title="Reviews — The Cut" description="One tested verdict per job, plus everything we rejected and why. No sponsored rankings.">
  <section class="container-wide list-hero">
    <span class="kicker">Crux Picks · The Cut</span>
    <h1 class="list-hero__title">One verdict. And everything we rejected.</h1>
    <p class="list-hero__sub">We try the serious options in a category, name the one worth paying for, and publish the ones that fell short — with the reason. When nothing is worth it, we say that instead.</p>
  </section>

  <section class="container-wide list-wrap">
    {reviews.length === 0 ? (
      <div class="empty-state">
        <p><b>The first reviews are being finished.</b></p>
        <p>They go live only once every claim, price and link has been checked by a person. If you want to know the moment the first one lands, the email list is where we announce it.</p>
        <div class="empty-state__form"><Newsletter size="minimal" /></div>
      </div>
    ) : (
      <ul class="entry-list">
        {reviews.map((r) => {
          const cat = getCategory(r.data.category);
          return (
            <li class="entry-card">
              <a href={`/reviews/${r.slug}/`}>
                <span class="entry-card__meta">{cat?.name ?? 'Review'} · {fmt(r.data.updatedDate ?? r.data.pubDate)}</span>
                <span class="entry-card__title">{r.data.title}</span>
                <span class="entry-card__excerpt">{r.data.excerpt}</span>
                <span class="entry-card__pick">Pick: <b>{r.data.pick.name}</b></span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</Base>
