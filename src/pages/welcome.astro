---
import Base from '../layouts/Base.astro';
---
<Base title="You're on the list" description="Thanks for subscribing to The Crux Co.">
  <section class="container welcome-page">
    <span class="meta-strip">Welcome</span>
    <h1>You're in.</h1>
    <p class="tag">
      One email a week, give or take. If there's nothing worth sending that week, we won't send
      anything — that's deliberate. New guides and products get announced here first, and usually
      only here.
    </p>
    <p style="margin-top:28px; font-family:var(--sans); font-size:15px; color:var(--muted);">
      While you're here: <a href="/essays/">the writing</a> is all free and ungated, and
      <a href="/standards/">the standard</a> explains what has to be true before we'll sell you
      anything.
    </p>
    <p style="margin-top:32px; font-family:var(--sans); font-size:14px;">
      <a href="/">← Back to the homepage</a>
    </p>
  </section>
</Base>
