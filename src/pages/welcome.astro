---
import Base from '../layouts/Base.astro';
---
<Base title="Welcome to The Crux." description="Welcome to TheCruxCo. Your first digest arrives tomorrow at 7:30 AM IST.">
  <section class="container welcome-page">
    <span class="kicker">Welcome</span>
    <h1>You're in.</h1>
    <p class="tag">
      Tomorrow morning at 7:30 AM IST, the first digest hits your inbox. Seven categories, thirty-five items, under seven minutes. Built so you spend the next twenty-five thinking, not scrolling.
    </p>
    <p style="margin-top:32px; font-family:var(--sans); font-size:14px;">
      <a href="/">← Back to today's digest</a>
    </p>
  </section>
</Base>
