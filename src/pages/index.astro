---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
import { BOARD } from '../config/career';
import '../styles/career.css';

const desc = 'The Crux is a growing family of things worth your time. The Crux Career is open: exam-ready study material, opening soon.';
---
<Base title={SITE.name} description={desc}>
  <section class="container-wide cx-hero">
    <span class="cx-eyebrow">The Crux</span>
    <h1>Cut <span class="cx-mark">through</span> the noise.</h1>
    <p class="cx-lede">The Crux is a growing family of things worth your time: study material, a store, articles and a lifestyle section. <strong>One is open today, The Crux Career.</strong> The rest are on the way.</p>
    <div class="cx-actions">
      <a class="btn-solid" href="/career/">Open The Crux Career →</a>
      <span class="cx-count" id="cx-count">CBSE boards start {BOARD.startLabel} · <b id="cx-days">--</b> days to go</span>
    </div>
  </section>

  <section class="container-wide cx-sec">
    <span class="cx-eyebrow">What is coming</span>
    <h2>One thing at a time.</h2>
    <p class="cx-sub">We open each section only when it is ready.</p>
    <div class="cx-family">
      <a class="cx-tile cx-tile--open" href="/career/">
        <span class="cx-pill cx-pill--live">OPEN NOW</span>
        <h3>The Crux Career</h3>
        <p>Exam-ready study material, opening soon.</p>
        <span class="cx-go">Enter →</span>
      </a>
      <div class="cx-tile cx-tile--soon">
        <span class="cx-pill">COMING SOON</span>
        <h3>The Crux Store</h3>
        <p>A small shelf of things we would actually use.</p>
      </div>
      <div class="cx-tile cx-tile--soon">
        <span class="cx-pill">COMING SOON</span>
        <h3>The Crux Articles</h3>
        <p>Short, sharp explainers that get to the point.</p>
      </div>
      <div class="cx-tile cx-tile--soon">
        <span class="cx-pill">COMING SOON</span>
        <h3>The Crux Lifestyle</h3>
        <p>Habits, routines and ideas for a better day.</p>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ start: BOARD.start }}>
    (function () {
      var d = Math.ceil((new Date(start).getTime() - Date.now()) / 86400000);
      var el = document.getElementById('cx-days');
      if (!el) return;
      if (d > 0) el.textContent = d;
      else document.getElementById('cx-count').textContent = 'Board season is here. Good luck.';
    })();
  </script>
</Base>
