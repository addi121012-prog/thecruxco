---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config/site';

const brief = (await getCollection('essays', e => !e.data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const featured = brief[0];
const restBrief = brief.slice(1, 4);

const reviews = (await getCollection('reviews', r => !r.data.draft))
  .sort((a, b) => +(b.data.updatedDate ?? b.data.pubDate) - +(a.data.updatedDate ?? a.data.pubDate))
  .slice(0, 3);

const fmt = (d: Date) => new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
const words = featured ? featured.body.trim().split(/\s+/).length : 0;
const minutes = Math.max(1, Math.round(words / 220));
---
<Base title={SITE.name} description={SITE.description}>

  <!-- Hero -->
  <section class="container-wide home-hero">
    <h1 class="home-hero__title">Cut through the noise.</h1>
    <p class="home-hero__sub">
      Honest, tested product reviews — the one worth buying, and why. Plus sharp daily takes on what's
      actually happening. The signal, without the scroll.
    </p>
    <div class="home-hero__actions">
      <a href="/reviews/" class="btn-solid">See the reviews →</a>
      <a href="/essays/" class="btn-line">Read {SITE.briefName}</a>
    </div>
  </section>

  <!-- Reviews -->
  <section class="container-wide home-section">
    <div class="sec-head sec-head--kicker">
      <span class="kicker">Reviews</span>
      <h2>One verdict per category. No sponsored rankings.</h2>
    </div>
    {reviews.length > 0 ? (
      <div class="home-latest__grid">
        {reviews.map((r) => (
          <a class="home-latest__card" href={`/reviews/${r.slug}/`}>
            <span class="home-latest__tag">Review · {fmt(r.data.updatedDate ?? r.data.pubDate)}</span>
            <span class="home-latest__title">{r.data.title}</span>
            <span class="home-latest__excerpt">{r.data.excerpt}</span>
          </a>
        ))}
      </div>
    ) : (
      <a class="home-teaser" href="/reviews/">
        <span class="home-teaser__title">The first tested reviews are landing now.</span>
        <span class="home-teaser__cta">See what's live →</span>
      </a>
    )}
  </section>

  <!-- The Brief -->
  <section class="container-wide home-section">
    <div class="sec-head sec-head--kicker">
      <span class="kicker">{SITE.briefName}</span>
      <h2>What's worth knowing today.</h2>
    </div>

    {featured && (
      <a href={`/essays/${featured.slug}/`} class="featured-card">
        <div class="featured-card__body">
          <div class="featured-card__meta">{minutes} MIN READ · {fmt(featured.data.pubDate).toUpperCase()}</div>
          <h3 class="featured-card__title">{featured.data.title}</h3>
          <p class="featured-card__excerpt">{featured.data.excerpt}</p>
        </div>
        <span class="featured-card__cta">Read it →</span>
      </a>
    )}

    {restBrief.length > 0 && (
      <ul class="home-more">
        {restBrief.map((e) => (
          <li>
            <a href={`/essays/${e.slug}/`}>
              <span class="home-more__meta">{fmt(e.data.pubDate)}</span>
              <span class="home-more__title">{e.data.title}</span>
            </a>
          </li>
        ))}
        <li>
          <a href="/essays/">
            <span class="home-more__meta">Everything</span>
            <span class="home-more__title">Browse {SITE.briefName} →</span>
          </a>
        </li>
      </ul>
    )}
  </section>

</Base>
