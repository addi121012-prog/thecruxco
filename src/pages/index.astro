---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import WhatsNext from '../components/WhatsNext.astro';
import TableOfContents from '../components/TableOfContents.astro';
import DigestBody from '../components/DigestBody.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config/site';

const digests = (await getCollection('digests', d => !d.data.draft && !d.slug.startsWith('drafts/')))
  .sort((a, b) => +b.data.date - +a.data.date);

const latest = digests[0];
const yesterday = digests[1];
const recentEssays = (await getCollection('essays', e => !e.data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 3);

const formatted = latest ? new Intl.DateTimeFormat('en-IN', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
}).format(latest.data.date) : '';

const itemCount = latest
  ? latest.data.categories.reduce((n, c) => n + c.items.length, 0)
  : 0;
---
<Base title={SITE.name} description={SITE.description}>
  <section class="container-wide hero">
    <div class="hero__topline">
      <span class="kicker">Today · {formatted}</span>
      <span class="streak-chip" data-streak-chip hidden></span>
    </div>
    <h1>{latest ? latest.data.title : 'Get to the crux.'}</h1>
    <p class="tag">
      {latest ? `${latest.data.categories.length} categories · ${itemCount} items · under ten minutes.` : 'Ten categories. Fifty items. Under ten minutes. Every day.'}
    </p>
  </section>

  <div class="layout">
    {latest && (
      <aside class="layout__toc">
        <TableOfContents categories={latest.data.categories} />
      </aside>
    )}

    <article class="layout__main">
      {latest && (
        <>
          {latest.data.editorsNote && (
            <p class="editors-note">{latest.data.editorsNote}</p>
          )}

          <DigestBody categories={latest.data.categories} permalink={`/digest/${latest.slug}/`} />

          <nav class="day-pager" aria-label="Digest navigation">
            {yesterday && (
              <a class="day-pager__link" href={`/digest/${yesterday.slug}/`}>
                ← Missed yesterday? Read {new Intl.DateTimeFormat('en-IN', { weekday: 'long' }).format(yesterday.data.date)}'s crux
              </a>
            )}
            <a class="day-pager__link" href="/digest/">Browse the archive →</a>
          </nav>
        </>
      )}

      {recentEssays.length > 0 && (
        <section style="margin-top:80px;">
          <span class="kicker">From the essays</span>
          <h2 style="margin-top:6px;">Slow ideas, written by hand.</h2>
          <ul class="card-list">
            {recentEssays.map((e) => (
              <li>
                <div class="meta">{e.data.author} · {new Intl.DateTimeFormat('en-IN', { day:'numeric', month:'short', year:'numeric'}).format(e.data.pubDate)}</div>
                <h3><a href={`/essays/${e.slug}/`}>{e.data.title}</a></h3>
                <p>{e.data.excerpt}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <aside class="layout__sidebar">
      <div class="sidebar-block">
        <Newsletter size="sidebar" />
      </div>
      <div class="sidebar-block">
        <AdSlot size="rectangle" />
      </div>
      <div class="sidebar-block">
        <WhatsNext variant="sidebar" />
      </div>
    </aside>
  </div>
</Base>
