---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../config/categories';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}
const { category } = Astro.props;
const reviews = (await getCollection('reviews', (r) => !r.data.draft && r.data.category === category.slug))
  .sort((a, b) => +(b.data.updatedDate ?? b.data.pubDate) - +(a.data.updatedDate ?? a.data.pubDate));
const fmt = (d: Date) => new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---
<Base title={category.name} description={category.description}>
  <section class="container-wide list-hero">
    <span class="kicker">Reviews</span>
    <h1 class="list-hero__title">{category.name}</h1>
    <p class="list-hero__sub">{category.intro}</p>
  </section>
  <section class="container-wide list-wrap">
    {reviews.length === 0 ? (
      <div class="empty-state"><p><b>The first tested verdicts in {category.name.toLowerCase()} are landing now.</b></p></div>
    ) : (
      <ul class="entry-list">
        {reviews.map((r) => (
          <li class="entry-card">
            <a href={`/reviews/${r.slug}/`}>
              <span class="entry-card__meta">Review · {fmt(r.data.updatedDate ?? r.data.pubDate)}</span>
              <span class="entry-card__title">{r.data.title}</span>
              <span class="entry-card__excerpt">{r.data.excerpt}</span>
              <span class="entry-card__pick">Pick: <b>{r.data.pick.name}</b></span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
