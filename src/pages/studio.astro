---
import Base from '../layouts/Base.astro';
import { STUDIO } from '../config/site';

const mailSubject = encodeURIComponent('Free sample article — Crux Studio');
const mailBody = encodeURIComponent(
  "Hi,\n\nI'd like a free sample article. Here's my site/business and the topic I'd want:\n\n- Website:\n- What we do:\n- Topic for the sample:\n\nThanks,"
);
const mailto = `mailto:${STUDIO.email}?subject=${mailSubject}&body=${mailBody}`;
const wa = STUDIO.whatsapp
  ? `https://wa.me/${STUDIO.whatsapp}?text=${encodeURIComponent("Hi — I saw Crux Studio and want a free sample article.")}`
  : '';
---
<Base
  title="Crux Studio — SEO content that ranks"
  description="Done-for-you SEO blog content for startups and small businesses. Researched, human-edited, and fast. First article free — if it doesn't beat what you'd write, you pay nothing."
>
  <section class="studio-hero">
    <div class="studio-wrap">
      <span class="kicker">Crux Studio</span>
      <h1 class="studio-hero__title">SEO content that actually ranks — without hiring a writer.</h1>
      <p class="studio-hero__sub">
        Researched, genuinely edited blog posts for startups and small businesses. Not raw AI slop,
        not ₹500 Fiverr filler — content built to bring you search traffic, delivered in days.
      </p>
      <div class="studio-hero__cta">
        <a class="btn-primary" href="#start">Get your first article free →</a>
        <a class="btn-ghost" href="#pricing">See pricing</a>
      </div>
      <p class="studio-hero__risk">First article free. If it doesn't beat what you'd have written, you pay nothing and keep it anyway.</p>
    </div>
  </section>

  <section class="studio-wrap studio-block">
    <h2 class="studio-h2">Most content fails for one of two reasons.</h2>
    <div class="studio-two">
      <div class="studio-card">
        <h3>It's AI slop.</h3>
        <p>Generated in one click, unedited, generic. Google's had updates specifically to bury it, and readers bounce in seconds. Cheap, and worth exactly that.</p>
      </div>
      <div class="studio-card">
        <h3>Or it's slow and expensive.</h3>
        <p>A good freelance writer costs ₹5–15k an article and takes a week. Fine once — impossible to do at the pace search actually rewards.</p>
      </div>
    </div>
    <p class="studio-lead">
      Crux Studio sits in the gap: the speed and cost of AI, with a human who understands search intent
      shaping every brief, fact and headline. You get content that reads like a person wrote it — because
      one finished it.
    </p>
  </section>

  <section class="studio-wrap studio-block">
    <h2 class="studio-h2">What you actually get.</h2>
    <ul class="studio-deliver">
      <li><b>Keyword &amp; intent research</b> — we write what your buyers are actually searching, not what sounds nice.</li>
      <li><b>A real edit</b> — structure, facts, flow and headline done by a human, every time.</li>
      <li><b>On-page SEO built in</b> — title, meta, headings, internal links, ready to publish.</li>
      <li><b>Fast turnaround</b> — first draft in days, not weeks.</li>
      <li><b>Publish-ready formatting</b> — paste it straight into your site or CMS.</li>
    </ul>
  </section>

  <section id="pricing" class="studio-wrap studio-block">
    <h2 class="studio-h2">Simple, productised pricing.</h2>
    <p class="studio-sub2">No calls, no quotes. Pick a plan, or start with one article. {STUDIO.usdNote}</p>
    <div class="studio-tiers">
      {STUDIO.tiers.map((t) => (
        <div class={`tier${t.highlight ? ' tier--hot' : ''}`}>
          {t.highlight && <span class="tier__flag">{t.best}</span>}
          <h3 class="tier__name">{t.name}</h3>
          <div class="tier__price">{t.price}<span>/{t.unit.replace('per ', '')}</span></div>
          {!t.highlight && <p class="tier__best">{t.best}</p>}
          <ul class="tier__features">
            {t.features.map((f) => <li>{f}</li>)}
          </ul>
          <a class={`tier__cta${t.highlight ? ' tier__cta--hot' : ''}`} href="#start">{t.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="studio-wrap studio-block">
    <h2 class="studio-h2">Who's behind it.</h2>
    <p class="studio-lead">
      Crux Studio is run by one person — a business analyst who's spent years turning messy requirements
      into clear, structured documents, and who now does the same for content: research it properly, write
      it with AI, and edit it like it has your name on it. Small, direct, and fast. You talk to the person
      doing the work, not an account manager.
    </p>
  </section>

  <section class="studio-wrap studio-block">
    <h2 class="studio-h2">Questions people ask.</h2>
    <div class="studio-faqs">
      <details class="faq"><summary class="faq__q">Is this just ChatGPT output?</summary><div class="faq__a"><p>No. AI does the first draft; a human does the research brief, the edit, the facts and the headline. That editing layer is the whole product — it's the difference between content that ranks and content that gets buried.</p></div></details>
      <details class="faq"><summary class="faq__q">How is the first article really free?</summary><div class="faq__a"><p>You tell us your site and a topic, we write one article. If it doesn't beat what you'd have produced, you pay nothing and keep it anyway. We only want clients who can see the difference.</p></div></details>
      <details class="faq"><summary class="faq__q">What niches do you cover?</summary><div class="faq__a"><p>Most B2B and consumer topics — SaaS, tech, health, finance, local services and more. If a topic needs specialist accuracy, we'll say so up front rather than fake it.</p></div></details>
      <details class="faq"><summary class="faq__q">How fast?</summary><div class="faq__a"><p>A single article in about three working days; retainer clients get priority two-day turnaround.</p></div></details>
    </div>
  </section>

  <section id="start" class="studio-wrap studio-block studio-cta">
    <h2 class="studio-h2">Get your first article free.</h2>
    <p class="studio-sub2">Tell us your site and one topic. You'll have a sample back in a few days. No card, no call.</p>

    {STUDIO.formEndpoint ? (
      <form class="studio-form" action={STUDIO.formEndpoint} method="POST">
        <input class="studio-input" type="text" name="name" placeholder="Your name" required />
        <input class="studio-input" type="email" name="email" placeholder="Email" required />
        <input class="studio-input" type="url" name="website" placeholder="Your website" />
        <textarea class="studio-input" name="topic" rows="3" placeholder="A topic you'd want the sample article on" required></textarea>
        <button class="btn-primary" type="submit">Send me my free sample →</button>
      </form>
    ) : (
      <div class="studio-contact">
        <a class="btn-primary" href={mailto}>Email for your free sample →</a>
        {wa && <a class="btn-ghost" href={wa} target="_blank" rel="noopener">WhatsApp us</a>}
        <p class="studio-contact__alt">Or write to <a href={mailto}>{STUDIO.email}</a></p>
      </div>
    )}
  </section>

  <style>
    .studio-wrap { max-width: 960px; margin: 0 auto; padding: 0 24px; }
    .studio-hero { padding: 72px 0 8px; text-align: center; }
    .studio-hero .kicker { display: inline-block; margin-bottom: 14px; }
    .studio-hero__title { font-size: clamp(30px, 5.2vw, 52px); line-height: 1.08; max-width: 15ch; margin: 0 auto 18px; }
    .studio-hero__sub { font-size: 20px; color: var(--muted); max-width: 60ch; margin: 0 auto 26px; }
    .studio-hero__cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .studio-hero__risk { font-family: var(--sans); font-size: 14px; color: var(--muted); margin-top: 18px; }

    .btn-primary { font-family: var(--sans); font-weight: 600; font-size: 16px; text-decoration: none; color: var(--paper); background: var(--accent); border: 1px solid var(--accent); border-radius: 9px; padding: 13px 22px; display: inline-block; }
    .btn-primary:hover { color: var(--paper); opacity: 0.9; }
    .btn-ghost { font-family: var(--sans); font-weight: 600; font-size: 16px; text-decoration: none; color: var(--ink); border: 1px solid var(--rule); border-radius: 9px; padding: 13px 22px; display: inline-block; }
    .btn-ghost:hover { border-color: var(--ink); color: var(--ink); }

    .studio-block { padding: 44px 24px; }
    .studio-h2 { font-size: clamp(24px, 3.5vw, 34px); margin: 0 0 8px; }
    .studio-sub2 { color: var(--muted); font-size: 17px; margin: 0 0 26px; }
    .studio-lead { font-size: 19px; max-width: 66ch; margin: 18px 0 0; }

    .studio-two { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 20px 0; }
    .studio-card { border: 1px solid var(--rule); border-radius: 12px; padding: 22px; background: var(--card); }
    .studio-card h3 { margin: 0 0 8px; font-size: 20px; }
    .studio-card p { margin: 0; color: var(--muted); }

    .studio-deliver { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; max-width: 70ch; }
    .studio-deliver li { padding-left: 26px; position: relative; }
    .studio-deliver li::before { content: "✓"; position: absolute; left: 0; color: var(--accent); font-family: var(--sans); font-weight: 700; }

    .studio-tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .tier { border: 1px solid var(--rule); border-radius: 14px; padding: 26px 22px; position: relative; background: var(--paper); display: flex; flex-direction: column; }
    .tier--hot { border: 2px solid var(--accent); }
    .tier__flag { position: absolute; top: -12px; left: 22px; background: var(--accent); color: var(--paper); font-family: var(--sans); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 10px; border-radius: 20px; }
    .tier__name { font-size: 21px; margin: 6px 0 2px; }
    .tier__price { font-size: 34px; font-weight: 700; font-family: var(--serif); margin: 6px 0; }
    .tier__price span { font-size: 15px; font-weight: 400; color: var(--muted); font-family: var(--sans); }
    .tier__best { font-family: var(--sans); font-size: 13px; color: var(--muted); margin: 0 0 12px; }
    .tier__features { list-style: none; padding: 0; margin: 12px 0 22px; display: grid; gap: 9px; font-size: 15px; }
    .tier__features li { padding-left: 22px; position: relative; }
    .tier__features li::before { content: "→"; position: absolute; left: 0; color: var(--accent); }
    .tier__cta { margin-top: auto; text-align: center; font-family: var(--sans); font-weight: 600; text-decoration: none; color: var(--ink); border: 1px solid var(--ink); border-radius: 9px; padding: 11px; }
    .tier__cta--hot { background: var(--accent); color: var(--paper); border-color: var(--accent); }
    .tier__cta:hover { opacity: 0.9; }

    .studio-faqs .faq { border-bottom: 1px solid var(--rule); }
    .studio-cta { text-align: center; border-top: 1px solid var(--rule); margin-top: 20px; }
    .studio-form { max-width: 460px; margin: 0 auto; display: grid; gap: 12px; }
    .studio-input { font-family: var(--sans); font-size: 15px; padding: 12px 14px; border: 1px solid var(--rule); border-radius: 8px; background: var(--paper); color: var(--ink); width: 100%; }
    .studio-contact { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; align-items: center; }
    .studio-contact__alt { flex-basis: 100%; color: var(--muted); font-family: var(--sans); font-size: 14px; margin: 6px 0 0; }

    @media (max-width: 760px) {
      .studio-two, .studio-tiers { grid-template-columns: 1fr; }
      .studio-hero { padding-top: 48px; }
    }
  </style>
</Base>
