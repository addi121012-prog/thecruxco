---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays', e => !e.data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 3);

const fmt = (d: Date) => new Intl.DateTimeFormat('en-IN', {
  day: 'numeric', month: 'short', year: 'numeric'
}).format(d);
---
<Base
  title="Subscribe"
  description="One email a week from The Crux Co. Usually something we've been researching, occasionally something we've decided not to build. Free, no ads, one click to unsubscribe."
>
  <section class="sub-hero container" id="top">
    <span class="meta-strip">The list</span>
    <h1>One email a week.<br /><span class="sub-hero__em">Nothing else.</span></h1>
    <p class="sub-hero__lede">
      Usually something we've been researching. Occasionally something we've decided
      <em>not</em> to build, and why. When a new guide or product is ready, this is where it gets
      announced — usually only here.
    </p>

    <div class="sub-hero__form">
      <Newsletter size="inline" heading="Join the list." />
    </div>

    <ul class="sub-trust">
      <li><strong>Free</strong></li>
      <li aria-hidden="true" class="sub-trust__dot">·</li>
      <li>No ads, no sponsors</li>
      <li aria-hidden="true" class="sub-trust__dot">·</li>
      <li>Unsubscribe link at the top of every email</li>
    </ul>
  </section>

  <!-- What you actually get -->
  <section class="container sub-benefits">
    <h2 class="sub-benefits__title">What you actually get</h2>
    <div class="sub-benefits__grid">
      <div class="sub-benefit">
        <span class="sub-benefit__num">1</span>
        <h3>One email, most weeks</h3>
        <p>Not daily. If there's nothing worth sending, we don't send anything — which happens, and we'd rather that than filler.</p>
      </div>
      <div class="sub-benefit">
        <span class="sub-benefit__num">0</span>
        <h3>Zero advertising</h3>
        <p>No sponsors, no paid placement, no undisclosed affiliate links. We tried ad funding once and it pointed everything at traffic instead of usefulness.</p>
      </div>
      <div class="sub-benefit">
        <span class="sub-benefit__num">→</span>
        <h3>First look at everything</h3>
        <p>New guides, the first Crux Picks verdicts, and the food brand when it exists. All of it gets announced here before anywhere else.</p>
      </div>
      <div class="sub-benefit">
        <span class="sub-benefit__num">✕</span>
        <h3>The things we killed</h3>
        <p>We publish what failed our own <a href="/standards/">standard</a> and why. That list is longer than the list of things we sell.</p>
      </div>
    </div>
  </section>

  <!-- A peek at the writing -->
  {essays.length > 0 && (
    <section class="container sub-sample">
      <div class="sub-sample__head">
        <span class="meta-strip">A peek at the writing</span>
        <span class="sub-sample__date">Free, ungated</span>
      </div>
      <ul class="sub-sample__list">
        {essays.map((e) => (
          <li>
            <span class="sub-sample__cat">{fmt(e.data.pubDate)}</span>
            <span class="sub-sample__hl"><a href={`/essays/${e.slug}/`}>{e.data.title}</a></span>
          </li>
        ))}
      </ul>
      <a class="sub-sample__cta" href="/essays/">Read it all first, then decide →</a>
    </section>
  )}

  <!-- Honest note -->
  <section class="container sub-close">
    <p class="sub-close__line">
      Worth saying plainly: this is a one-person company that is early, and the list is small.
      You'd be joining before it's impressive. <em>That's the trade.</em>
    </p>
    <a class="sub-close__btn" href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;">Join the list →</a>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .sub-hero {
    text-align: center;
    padding: 64px 0 28px;
    max-width: 720px;
  }
  .sub-hero h1 {
    font-size: clamp(34px, 6vw, 56px);
    line-height: 1.08;
    margin: 14px 0 18px;
    letter-spacing: -0.02em;
  }
  .sub-hero__em { color: var(--accent); }
  .sub-hero__lede {
    font-size: clamp(17px, 2.4vw, 21px);
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.55;
  }
  .sub-hero__lede em { color: var(--ink); font-style: italic; }
  .sub-hero__form {
    max-width: 540px;
    margin: 26px auto 0;
  }
  .sub-trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 14px 0 0;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
  }
  .sub-trust strong { color: var(--ink); font-weight: 600; }
  .sub-trust__dot { color: var(--rule); }

  /* ---- Sample ---- */
  .sub-sample {
    max-width: 640px;
    margin-top: 56px;
    padding: 30px 32px 26px;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--card);
  }
  .sub-sample__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .sub-sample__date {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .sub-sample__list { list-style: none; padding: 0; margin: 0; }
  .sub-sample__list li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
  }
  .sub-sample__cat {
    font-family: var(--sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    flex: 0 0 92px;
  }
  .sub-sample__hl { font-size: 16px; line-height: 1.4; }
  .sub-sample__hl a { text-decoration: none; }
  .sub-sample__hl a:hover { color: var(--accent); }
  .sub-sample__cta {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--sans);
    font-size: 14px;
    color: var(--accent);
    text-decoration: none;
  }
  .sub-sample__cta:hover { text-decoration: underline; }

  /* ---- Benefits ---- */
  .sub-benefits { max-width: 760px; margin-top: 56px; text-align: center; }
  .sub-benefits__title { font-size: 28px; margin: 0 0 28px; }
  .sub-benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    text-align: left;
  }
  .sub-benefit {
    padding: 22px 24px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .sub-benefit:hover { border-color: var(--accent); transform: translateY(-2px); }
  .sub-benefit__num {
    display: block;
    font-family: var(--serif);
    font-size: 34px;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .sub-benefit h3 { font-size: 18px; margin: 0 0 8px; }
  .sub-benefit p { font-size: 15px; color: var(--muted); margin: 0; line-height: 1.55; }

  /* ---- Closing ---- */
  .sub-close { max-width: 640px; text-align: center; margin: 56px auto 16px; }
  .sub-close__line { font-size: 20px; color: var(--ink); margin: 0 0 22px; line-height: 1.5; }
  .sub-close__line em { color: var(--accent); font-style: italic; }
  .sub-close__btn {
    display: inline-block;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 500;
    padding: 13px 26px;
    color: var(--paper);
    background: var(--ink);
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .sub-close__btn:hover { opacity: 0.85; color: var(--paper); }

  @media (max-width: 620px) {
    .sub-hero { padding: 40px 0 20px; }
    .sub-benefits__grid { grid-template-columns: 1fr; }
    .sub-sample { padding: 24px 20px; }
    .sub-sample__list li { flex-direction: column; gap: 4px; }
    .sub-sample__cat { flex-basis: auto; }
  }
</style>
