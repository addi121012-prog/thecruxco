---
import Auth from '../layouts/Auth.astro';
---
<Auth title="Set new password">
  <h1>Set a new password</h1>
  <p class="sub">Choose a strong password you don't use elsewhere.</p>
  <form id="f">
    <div class="field"><label for="password">New password <span class="hint">— at least 8 characters</span></label><input class="input" id="password" type="password" minlength="8" required /></div>
    <div class="formerror" id="err"></div>
    <button class="btn btn--primary" style="width:100%" type="submit">Update password</button>
    <p id="msg" class="muted" style="margin-top:12px;text-align:center"></p>
  </form>
  <div slot="foot" class="authfoot"><a href="/login">← Back to log in</a></div>
  <script slot="scripts" is:inline>
    const f = document.getElementById('f'), err = document.getElementById('err'), msg = document.getElementById('msg');
    const token = new URLSearchParams(location.search).get('token') || '';
    if (!token) { err.textContent = 'Missing reset token.'; }
    f.addEventListener('submit', async (e) => {
      e.preventDefault(); err.textContent = ''; const btn = f.querySelector('button'); btn.disabled = true;
      try { const d = await Crux.api('POST', '/api/auth/reset', { token, password: password.value }); msg.innerHTML = d.message + ' <a href="/login">Log in →</a>'; f.querySelector('button').style.display = 'none'; }
      catch (ex) { err.textContent = ex.message; btn.disabled = false; }
    });
  </script>
</Auth>
