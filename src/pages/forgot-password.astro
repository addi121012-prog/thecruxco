---
import Auth from '../layouts/Auth.astro';
---
<Auth title="Reset password">
  <h1>Reset your password</h1>
  <p class="sub">We'll email you a link to set a new one.</p>
  <form id="f">
    <div class="field"><label for="email">Work email</label><input class="input" id="email" name="email" type="email" required /></div>
    <div class="formerror" id="err"></div>
    <button class="btn btn--primary" style="width:100%" type="submit">Send reset link</button>
    <p id="msg" class="muted" style="margin-top:12px;text-align:center"></p>
  </form>
  <div slot="foot" class="authfoot"><a href="/login">← Back to log in</a></div>
  <script slot="scripts" is:inline>
    const f = document.getElementById('f'), err = document.getElementById('err'), msg = document.getElementById('msg');
    f.addEventListener('submit', async (e) => {
      e.preventDefault(); err.textContent = ''; msg.textContent = ''; const btn = f.querySelector('button'); btn.disabled = true;
      try { const d = await Crux.api('POST', '/api/auth/request-reset', { email: email.value }); msg.textContent = d.message; }
      catch (ex) { err.textContent = ex.message; } finally { btn.disabled = false; }
    });
  </script>
</Auth>
