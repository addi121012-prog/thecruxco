---
import Auth from '../layouts/Auth.astro';
---
<Auth title="Log in">
  <h1>Welcome back</h1>
  <p class="sub">Log in to your sales workspace.</p>
  <form id="f">
    <div class="field"><label for="email">Work email</label><input class="input" id="email" name="email" type="email" autocomplete="email" required /></div>
    <div class="field"><label for="password">Password</label><input class="input" id="password" name="password" type="password" autocomplete="current-password" required /></div>
    <div class="formerror" id="err"></div>
    <button class="btn btn--primary" style="width:100%" type="submit">Log in</button>
  </form>
  <div style="text-align:center;margin-top:12px"><a href="/forgot-password" class="muted" style="font-size:13px">Forgot your password?</a></div>
  <div slot="foot" class="authfoot">New to The Crux? <a href="/signup">Start free →</a></div>
  <script slot="scripts" is:inline>
    const f = document.getElementById('f'), err = document.getElementById('err');
    const next = new URLSearchParams(location.search).get('next');
    f.addEventListener('submit', async (e) => {
      e.preventDefault(); err.textContent = ''; const btn = f.querySelector('button'); btn.disabled = true;
      try {
        const d = await Crux.api('POST', '/api/auth/login', { email: email.value, password: password.value });
        location.href = next || d.redirect || '/app';
      } catch (ex) { err.textContent = ex.message; btn.disabled = false; }
    });
  </script>
</Auth>
