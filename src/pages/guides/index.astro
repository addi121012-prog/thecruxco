---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { getCategory } from '../../config/categories';

const guides = (await getCollection('articles', (a) => !a.data.draft))
  .sort((a, b) => +(b.data.updatedDate ?? b.data.pubDate) - +(a.data.updatedDate ?? a.data.pubDate));
const essays = (await getCollection('essays', (e) => !e.data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const fmt = (d: Date) => new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---
<Base title="Guides" description="Short, finishable guides on things usually explained badly — with sources, and a length told to you up front.">
  <section class="container-wide list-hero">
    <span class="kicker">Crux Guides</span>
    <h1 class="list-hero__title">Guides that end when the useful part ends.</h1>
    <p class="list-hero__sub">Explainers and how-tos on things that are usually explained badly. We tell you the length before you start, we list our sources, and where a decision comes down to a specific product, we point you to the review.</p>
  </section>

  <section class="container-wide list-wrap">
    {guides.length === 0 ? (
      <div class="empty-state">
        <p><b>The first guides are being finished.</b></p>
        <p>Meanwhile, the long-form essays below are live and free to read.</p>
        <div class="empty-state__form"><Newsletter size="minimal" /></div>
      </div>
    ) : (
      <ul class="entry-list">
        {guides.map((g) => {
          const cat = getCategory(g.data.category);
          return (
            <li class="entry-card">
              <a href={`/guides/${g.slug}/`}>
                <span class="entry-card__meta">{cat?.name ?? 'Guide'} · {fmt(g.data.updatedDate ?? g.data.pubDate)}</span>
                <span class="entry-card__title">{g.data.title}</span>
                <span class="entry-card__excerpt">{g.data.excerpt}</span>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    {essays.length > 0 && (
      <div class="list-sub">
        <h2 class="list-sub__title">Essays</h2>
        <ul class="entry-list">
          {essays.map((e) => (
            <li class="entry-card">
              <a href={`/essays/${e.slug}/`}>
                <span class="entry-card__meta">Essay · {e.data.author} · {fmt(e.data.pubDate)}</span>
                <span class="entry-card__title">{e.data.title}</span>
                <span class="entry-card__excerpt">{e.data.excerpt}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>
