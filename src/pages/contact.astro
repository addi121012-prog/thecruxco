---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Get in touch with TheCruxCo — tips, corrections, sponsorships, or to write for us.">
  <article class="container">
    <header style="padding-top:32px;">
      <span class="kicker">Contact</span>
      <h1>Say hello.</h1>
    </header>
    <div class="prose">
      <p><strong>General, story tips, corrections:</strong><br/>
      <a href="mailto:hello@thecruxco.com">hello@thecruxco.com</a></p>

      <p><strong>Sponsorships and partnerships:</strong><br/>
      <a href="mailto:partners@thecruxco.com">partners@thecruxco.com</a></p>

      <p><strong>To write for us:</strong><br/>
      <a href="mailto:write@thecruxco.com">write@thecruxco.com</a> — include a 200-word pitch and a writing sample. We pay per essay; bylines are pen names by default.</p>

      <p>We try to reply within 48 hours, but cannot guarantee a response to every message. Please don't send PR pitches; they will be ignored.</p>
    </div>
  </article>
</Base>
