---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Get in touch with The Crux — tips, corrections, or feedback.">
  <article class="container">
    <header style="padding-top:32px;">
      <span class="kicker">Contact</span>
      <h1>Say hello.</h1>
    </header>
    <div class="prose">
      <p><strong>General, story tips, corrections:</strong><br/>
      <a href="mailto:hello@thecruxco.com">hello@thecruxco.com</a></p>

      <p>Spotted a mistake in a review or a piece? Tell us — corrections get fixed on the page where the mistake was.</p>

      <p>We try to reply within 48 hours, but can't promise a response to every message.</p>
    </div>
  </article>
</Base>
