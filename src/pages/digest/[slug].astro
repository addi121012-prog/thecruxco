---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Newsletter from '../../components/Newsletter.astro';
import WhatsNext from '../../components/WhatsNext.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import DigestBody from '../../components/DigestBody.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const digests = (await getCollection('digests', d => !d.data.draft))
    .sort((a, b) => +b.data.date - +a.data.date); // newest first
  return digests.map((d, i) => ({
    params: { slug: d.slug },
    props: {
      entry: d,
      // newest-first sort: i+1 is the previous (older) day, i-1 the next (newer)
      prev: digests[i + 1] ?? null,
      next: digests[i - 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const formatted = new Intl.DateTimeFormat('en-IN', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
}).format(data.date);
const desc = `The daily digest for ${formatted}. Ten categories. Fifty items. Under ten minutes.`;
const dayName = (d: Date) => new Intl.DateTimeFormat('en-IN', { weekday: 'long', day: 'numeric', month: 'short' }).format(d);
---
<Base title={data.title} description={desc} ogType="article" pubDate={data.date}>
  <div class="layout">
    <aside class="layout__toc">
      <TableOfContents categories={data.categories} />
    </aside>

    <article class="layout__main">
      <header class="digest-intro" style="padding-top:32px;">
        <div class="hero__topline">
          <span class="kicker">Daily Digest · {formatted}</span>
          <span class="streak-chip" data-streak-chip hidden></span>
        </div>
        <h1>{data.title}</h1>
        {data.editorsNote && <p class="editors-note">{data.editorsNote}</p>}
      </header>

      <DigestBody categories={data.categories} permalink={`/digest/${entry.slug}/`} />

      <nav class="day-pager" aria-label="Digest navigation">
        {prev ? (
          <a class="day-pager__link" href={`/digest/${prev.slug}/`}>← {dayName(prev.data.date)}</a>
        ) : <span />}
        <a class="day-pager__link" href="/digest/">Archive</a>
        {next ? (
          <a class="day-pager__link" href={`/digest/${next.slug}/`}>{dayName(next.data.date)} →</a>
        ) : <span />}
      </nav>
    </article>

    <aside class="layout__sidebar">
      <div class="sidebar-block">
        <Newsletter size="sidebar" />
      </div>
      <div class="sidebar-block">
        <AdSlot size="rectangle" />
      </div>
      <div class="sidebar-block">
        <WhatsNext variant="sidebar" />
      </div>
    </aside>
  </div>
</Base>
