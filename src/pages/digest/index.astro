---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const digests = (await getCollection('digests', d => !d.data.draft && !d.slug.startsWith('drafts/')))
  .sort((a, b) => +b.data.date - +a.data.date);

const fmtDay = (d: Date) => new Intl.DateTimeFormat('en-IN', { weekday: 'short' }).format(d);
const fmtDate = (d: Date) => new Intl.DateTimeFormat('en-IN', {
  day: 'numeric', month: 'long', year: 'numeric'
}).format(d);
---
<Base
  title="Digest archive"
  description="The complete archive of The Crux daily news digest, published May to July 2026. No longer updated."
>
  <section class="container">
    <header class="page-head">
      <span class="meta-strip">Archive · Closed</span>
      <h1>The daily digest, May to July 2026.</h1>
      <p>
        {digests.length} editions. We stopped publishing on 2 July 2026 — the ad-funded model was
        never going to work, and we'd rather close something than let it rot.
        <a href="/about/">Here's the longer version</a>. Everything below stays up and stays free.
      </p>
    </header>

    <ul class="archive-list">
      {digests.map((d, i) => {
        const itemCount = d.data.categories.reduce((n, c) => n + c.items.length, 0);
        const lead = d.data.categories[0]?.items[0]?.headline;
        return (
          <li class="archive-card">
            <a href={`/digest/${d.slug}/`} class="archive-card__link">
              <div class="archive-card__date">
                <span class="archive-card__day">{fmtDay(d.data.date)}</span>
                <span class="archive-card__full">{fmtDate(d.data.date)}</span>
                {i === 0 && <span class="archive-card__badge">Final edition</span>}
              </div>
              <div class="archive-card__body">
                {lead && <p class="archive-card__lead">{lead}</p>}
                {d.data.editorsNote && <p class="archive-card__note">{d.data.editorsNote}</p>}
                <p class="archive-card__meta">{d.data.categories.length} categories · {itemCount} items</p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Base>
