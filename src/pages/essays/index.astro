---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../config/site';
const posts = (await getCollection('essays', e => !e.data.draft)).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const fmt = (d: Date) => new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---
<Base title={SITE.briefName} description="Short, sharp takes on what's trending — the story, why it matters, and what to take away.">
  <section class="container-wide list-hero">
    <span class="kicker">{SITE.briefName}</span>
    <h1 class="list-hero__title">What's worth knowing.</h1>
    <p class="list-hero__sub">Short, sharp takes on what's actually happening — the story, why it matters, and what to take away. No filler, no fifty tabs.</p>
  </section>
  <section class="container-wide list-wrap">
    {posts.length === 0 ? (
      <div class="empty-state"><p><b>The first pieces are landing shortly.</b></p></div>
    ) : (
      <ul class="entry-list">
        {posts.map((e) => (
          <li class="entry-card">
            <a href={`/essays/${e.slug}/`}>
              <span class="entry-card__meta">{fmt(e.data.pubDate)}</span>
              <span class="entry-card__title">{e.data.title}</span>
              <span class="entry-card__excerpt">{e.data.excerpt}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
