---
import '../styles/app.css';
const { title = 'The Crux' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · The Crux</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body{display:grid;place-items:center;min-height:100vh;background:var(--bg);padding:24px}
    .authcard{width:100%;max-width:400px}
    .authbrand{display:flex;align-items:center;justify-content:center;gap:9px;font-weight:800;font-size:20px;letter-spacing:-.02em;margin-bottom:20px}
    .authbrand .dot{width:26px;height:26px;border-radius:7px;background:var(--accent);color:#fff;display:grid;place-items:center;font-weight:800}
    .authcard .card__pad{padding:26px}
    .authcard h1{font-size:20px;margin-bottom:4px}
    .authcard .sub{color:var(--muted);margin-bottom:20px;font-size:13.5px}
    .authfoot{text-align:center;margin-top:16px;color:var(--muted);font-size:13.5px}
    .authfoot a{color:var(--accent);font-weight:650}
  </style>
</head>
<body>
  <div class="authcard">
    <a class="authbrand" href="/"><span class="dot">C</span> The Crux</a>
    <div class="card"><div class="card__pad"><slot /></div></div>
    <slot name="foot" />
  </div>
  <script src="/app.js" is:inline></script>
  <slot name="scripts" />
</body>
</html>
