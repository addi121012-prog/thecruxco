---
import '../styles/app.css';
import { roleLabel } from '../server/rbac';
const { title = 'The Crux CRM', active = '' } = Astro.props;
const user = Astro.locals.user;
const member = Astro.locals.member;
const ws = Astro.locals.workspace;
const trial = Astro.locals.trial;
const admin = member?.role === 'admin';
const initials = (user?.name || user?.email || '?').trim().slice(0, 1).toUpperCase();
const nav = [
  { k: 'dashboard', label: 'Dashboard', href: '/app', d: 'M3 12l9-9 9 9M5 10v10h5v-6h4v6h5V10' },
  { k: 'leads', label: 'Leads', href: '/app/leads', d: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11' },
  { k: 'opportunities', label: 'Opportunities', href: '/app/opportunities', d: 'M3 3v18h18M7 15l4-4 3 3 5-6' },
  { k: 'presales', label: 'Pre-Sales', href: '/app/presales', d: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h4' },
  { k: 'proposals', label: 'Proposals', href: '/app/proposals', d: 'M4 4a2 2 0 0 1 2-2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM15 2v6h5' },
  { k: 'tasks', label: 'Tasks', href: '/app/tasks', d: 'M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9' },
  { k: 'reports', label: 'Reports', href: '/app/reports', d: 'M3 3v18h18M8 17V9M13 17V5M18 17v-6' },
  { k: 'import', label: 'Import', href: '/app/import', d: 'M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · The Crux</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <a class="sidebar__brand" href="/app"><span class="dot">C</span> The Crux</a>
      <nav class="nav">
        {nav.map((n) => (
          <a href={n.href} class={active === n.k ? 'active' : ''}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={n.d} /></svg>
            {n.label}
          </a>
        ))}
        {admin && (<><div class="nav__sep"></div>
          <a href="/app/team" class={active === 'team' ? 'active' : ''}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0 .01M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            Team
          </a>
          <a href="/app/settings" class={active === 'settings' ? 'active' : ''}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
            Settings
          </a>
        </>)}
      </nav>
      <div class="sidebar__foot">
        <a class="usermenu" href="/app/settings">
          <span class="avatar">{initials}</span>
          <span style="min-width:0">
            <span style="display:block;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{user?.name || user?.email}</span>
            <span class="faint" style="font-size:12px">{roleLabel(member?.role || '')}</span>
          </span>
        </a>
        <a class="btn btn--sm btn--ghost" href="/api/auth/logout" style="width:100%;margin-top:6px;justify-content:flex-start;color:var(--muted)">Log out</a>
      </div>
    </aside>
    <div class="main">
      {trial && !trial.active && (
        <div class={'trialbar' + (trial.expired ? ' expired' : '')}>
          {trial.expired
            ? (<span>Your free trial has ended — the workspace is read-only. <a href="/app/settings#billing">Upgrade to keep going →</a></span>)
            : (<span>You're on the <strong>30-day free trial</strong> — <strong>{trial.daysLeft} {trial.daysLeft === 1 ? 'day' : 'days'}</strong> left. <a href="/app/settings#billing">See plans →</a></span>)}
        </div>
      )}
      <header class="topbar">
        <button class="hamburger" data-hamburger aria-label="Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
        <h1>{title}</h1>
        <div class="topbar__spacer"></div>
        <span class="chip" title="Workspace">{ws?.name}</span>
      </header>
      <main class="content">
        <slot />
      </main>
    </div>
  </div>
  <script src="/app.js" is:inline></script>
  <slot name="scripts" />
</body>
</html>
