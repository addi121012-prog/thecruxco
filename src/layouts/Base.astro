---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE } from '../config/site';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogType?: string;
  pubDate?: Date;
  author?: string;
  keywords?: string[];
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  pubDate,
  author,
  keywords = [
    'India news',
    'daily news digest',
    'knowledge news',
    'Indian news',
    'business news India',
    'geopolitics news',
    'AI news',
    'science news India',
    'Inshorts alternative',
    'intelligent news',
  ],
} = Astro.props;

const fullTitle = title === SITE.name ? `${SITE.brand} — ${SITE.tagline}` : `${title} · ${SITE.brand}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const isArticle = ogType === 'article';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords.join(', ')} />
  <meta name="author" content={author ?? 'TheCruxCo Editorial'} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

  {/* Open Graph */}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_IN" />
  {isArticle && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

  {/* Twitter */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />

  {/* JSON-LD structured data */}
  <StructuredData
    type={isArticle ? 'article' : 'website'}
    title={title}
    description={description}
    pubDate={pubDate}
    author={author}
    url={canonical}
  />

  {/* FOUC-prevention: set theme attribute before paint based on localStorage. */}
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('crux-theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (e) {}
    })();
  </script>

  <!-- Cloudflare Web Analytics: paste token before launch
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js'
    data-cf-beacon='{"token": "YOUR_TOKEN_HERE"}'></script>
  -->
</head>
<body>
  <div class="read-progress" aria-hidden="true"><div class="read-progress__bar" data-progress-bar></div></div>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <button class="back-to-top" data-back-to-top type="button" aria-label="Back to top" hidden>↑</button>

  <script is:inline>
    (function () {
      var ticking = false;
      var bar = document.querySelector('[data-progress-bar]');
      var topBtn = document.querySelector('[data-back-to-top]');

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          if (bar) bar.style.transform = 'scaleX(' + (max > 0 ? h.scrollTop / max : 0) + ')';
          if (topBtn) topBtn.hidden = h.scrollTop < 900;
          ticking = false;
        });
      }
      document.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      if (topBtn) topBtn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // TOC scroll-spy: highlight the category currently in view.
      var links = document.querySelectorAll('.toc__link');
      var sections = document.querySelectorAll('[data-category-section]');
      if (links.length && sections.length && 'IntersectionObserver' in window) {
        var map = {};
        links.forEach(function (l) { map[l.getAttribute('href')] = l; });
        var current = null;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              var link = map['#' + en.target.id];
              if (link && link !== current) {
                if (current) current.classList.remove('toc__link--active');
                link.classList.add('toc__link--active');
                current = link;
              }
            }
          });
        }, { rootMargin: '-15% 0px -70% 0px' });
        sections.forEach(function (s) { io.observe(s); });
      }
    })();
  </script>
</body>
</html>
