---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';

export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  author?: string;
  kicker?: string;
}

const { title, description, pubDate, author, kicker } = Astro.props;

const formatted = new Intl.DateTimeFormat('en-IN', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
}).format(pubDate);
---
<Base title={title} description={description} ogType="article">
  <article class="container">
    <header>
      {kicker && <span class="kicker">{kicker}</span>}
      <h1>{title}</h1>
      <p class="byline">
        {author ? `By ${author}` : 'By a Correspondent'} · <span class="dateline">{formatted}</span>
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
    <AdSlot size="rectangle" />
  </article>
</Base>
