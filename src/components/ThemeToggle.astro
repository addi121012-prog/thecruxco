---
// Light/dark theme toggle button. Persists choice in localStorage.
// Initial theme is set by the inline script in Base.astro <head> to avoid FOUC.
---

<button
  type="button"
  id="crux-theme-toggle"
  class="theme-toggle"
  aria-label="Toggle light or dark theme"
  title="Toggle theme"
>
  {/* Sun icon — shown in dark mode (click to go light) */}
  <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
       aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  {/* Moon icon — shown in light mode (click to go dark) */}
  <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
       aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById('crux-theme-toggle');
    if (!btn) return;

    function currentTheme() {
      const explicit = document.documentElement.getAttribute('data-theme');
      if (explicit === 'dark' || explicit === 'light') return explicit;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    btn.addEventListener('click', function () {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('crux-theme', next); } catch (e) {}
    });
  })();
</script>
