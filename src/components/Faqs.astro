---
export interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
}
const { faqs, heading = 'Common questions' } = Astro.props;

const schema = faqs.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
{faqs.length > 0 && (
  <section class="faqs" aria-label="Frequently asked questions">
    <h2 class="faqs__heading">{heading}</h2>
    <div class="faqs__list">
      {faqs.map((f) => (
        <details class="faq">
          <summary class="faq__q">{f.q}</summary>
          <div class="faq__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </section>
)}
