---
export interface Props {
  variant?: 'sidebar' | 'block';
}

const { variant = 'sidebar' } = Astro.props;

const cards = [
  {
    name: 'The Crux Monthly',
    kicker: 'E-magazine',
    blurb: 'A monthly long-form PDF for subscribers. First issue October 2026.',
    status: 'Coming soon',
  },
  {
    name: 'The Crux Markets',
    kicker: 'Daily brief',
    blurb: 'A 5-min markets digest for finance professionals. Early 2027.',
    status: 'Coming soon',
  },
  {
    name: 'The Crux Store',
    kicker: 'Merchandise',
    blurb: 'Notebooks, posters, the annual yearbook. On the desk.',
    status: 'Coming soon',
  },
];
---

<section class={`whats-next whats-next--${variant}`} aria-labelledby="whats-next-heading">
  <h3 id="whats-next-heading" class="whats-next__sidebar-title">What's next</h3>
  <div class="whats-next__stack">
    {cards.map((c) => (
      <article class="whats-next__card">
        <div class="whats-next__card-head">
          <span class="kicker whats-next__kicker">{c.kicker}</span>
          <span class="whats-next__badge">{c.status}</span>
        </div>
        <h4 class="whats-next__name">{c.name}</h4>
        <p class="whats-next__blurb">{c.blurb}</p>
      </article>
    ))}
  </div>
</section>
