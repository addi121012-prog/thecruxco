---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container-wide">
    <div class="footer-grid footer-grid--simple">
      <div class="footer-brand">
        <div class="footer-mark">The Crux<span class="dot">.</span></div>
        <p class="footer-tag">Cut through<br />the noise.</p>
      </div>

      <div class="footer-col">
        <h4>Read</h4>
        <a href="/reviews/">Reviews</a>
        <a href="/essays/">{SITE.briefName}</a>
      </div>

      <div class="footer-col">
        <h4>Site</h4>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/rss.xml">RSS</a>
      </div>

      <div class="footer-col">
        <h4>Legal</h4>
        <a href="/disclosure/">Affiliate disclosure</a>
        <a href="/privacy/">Privacy</a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-promises">
        <span>Independent.</span>
        <span>No sponsored rankings.</span>
        <span>Affiliate links always disclosed.</span>
      </div>
      <div>© {year} The Crux · India</div>
    </div>
  </div>
</footer>
