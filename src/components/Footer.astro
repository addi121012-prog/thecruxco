---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container-wide">
    <div class="footer-grid footer-grid--simple">
      <div class="footer-brand">
        <div class="footer-mark">The Crux<span class="dot">.</span></div>
        <p class="footer-tag">Useful tools for<br />messy business problems.</p>
      </div>
      <div class="footer-col">
        <h4>Product</h4>
        <a href="/#product">Sales &amp; Pre-Sales CRM</a>
        <a href="/pricing/">Pricing</a>
        <a href="/signup">Start free</a>
        <a href="/login">Log in</a>
      </div>
      <div class="footer-col">
        <h4>Read</h4>
        <a href="/essays/">{SITE.briefName}</a>
        <a href="/reviews/">Reviews</a>
        <a href="/rss.xml">RSS</a>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
        <a href="/disclosure/">Disclosure</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-promises"><span>Simple by design.</span><span>Start in minutes.</span><span>No CRM consultant required.</span></div>
      <div>© {year} The Crux · India</div>
    </div>
  </div>
</footer>
