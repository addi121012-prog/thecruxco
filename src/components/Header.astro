---
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const onCareer = path.startsWith('/career');
---
<header class="site-header">
  <div class="container-wide row">
    <a href="/" class="brand">The Crux<span class="dot">.</span></a>
    <div class="header-right">
      <nav class="nav" aria-label="Primary">
        <a href="/career/" class={`nav-career ${onCareer ? 'active' : ''}`} aria-current={onCareer ? 'page' : undefined}>Career</a>
        <a class="nav-soon" aria-disabled="true" tabindex="-1">Store</a>
        <a class="nav-soon" aria-disabled="true" tabindex="-1">Articles</a>
        <a class="nav-soon" aria-disabled="true" tabindex="-1">Lifestyle</a>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
