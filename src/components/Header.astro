---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (p: string) => path === p || (p !== '/' && path.startsWith(p));
---
<header class="site-header">
  <div class="container-wide row">
    <a href="/" class="brand">
      The Crux<span class="brand__co"> Co</span><span class="dot">.</span>
    </a>
    <div class="header-right">
      <nav class="nav" aria-label="Primary">
        <a href="/essays/" class={isActive('/essays') ? 'active' : ''}>Writing</a>
        <a href="/digest/" class={isActive('/digest') ? 'active' : ''}>Archive</a>
        <a href="/standards/" class={isActive('/standards') ? 'active' : ''}>Standards</a>
        <a href="/about/" class={isActive('/about') ? 'active' : ''}>About</a>
      </nav>
      <ThemeToggle />
      <a href="/subscribe/" class="header-cta">Subscribe</a>
    </div>
  </div>
</header>
