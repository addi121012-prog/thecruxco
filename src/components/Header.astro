---
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || (p !== '/' && path.startsWith(p));
---
<header class="site-header">
  <div class="container-wide row">
    <a href="/" class="brand">The Crux<span class="dot">.</span></a>
    <div class="header-right">
      <nav class="nav" aria-label="Primary">
        <a href="/#product">Product</a>
        <a href="/pricing/" class={isActive('/pricing') ? 'active' : ''}>Pricing</a>
        <a href="/essays/" class={isActive('/essays') ? 'active' : ''}>Essays</a>
        <a href="/about/" class={isActive('/about') ? 'active' : ''}>About</a>
      </nav>
      <a href="/login" class="nav-login">Log in</a>
      <a href="/signup" class="btn-solid btn-solid--sm">Start free</a>
      <ThemeToggle />
    </div>
  </div>
</header>
