---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../config/site';
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || (p !== '/' && path.startsWith(p));
---
<header class="site-header">
  <div class="container-wide row">
    <a href="/" class="brand">The Crux<span class="dot">.</span></a>
    <div class="header-right">
      <nav class="nav" aria-label="Primary">
        <a href="/reviews/" class={isActive('/reviews') ? 'active' : ''}>Reviews</a>
        <a href="/essays/" class={isActive('/essays') ? 'active' : ''}>{SITE.briefName}</a>
        <a href="/about/" class={isActive('/about') ? 'active' : ''}>About</a>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
