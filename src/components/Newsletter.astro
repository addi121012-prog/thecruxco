---
import { NEWSLETTER } from '../config/site';

export interface Props {
  size?: 'sidebar' | 'inline' | 'minimal';
  heading?: string;
  kicker?: string;
}

const { size = 'inline', heading, kicker } = Astro.props;

const defaults = {
  sidebar: {
    kicker: 'The list',
    heading: 'One email a week.',
    blurb: 'Something we’ve been researching, or something we’ve decided not to build. Free, no ads.',
  },
  inline: {
    kicker: 'The list',
    heading: 'One email a week.',
    blurb: 'Something we’ve been researching, or something we’ve decided not to build. New work gets announced here first, and usually only here.',
  },
  minimal: {
    kicker: 'Subscribe',
    heading: 'One email a week.',
    blurb: 'Free. No ads. Unsubscribe any time.',
  },
};

const cfg = defaults[size] ?? defaults.inline;
const finalHeading = heading ?? cfg.heading;
const finalKicker = kicker ?? cfg.kicker;
const isSidebar = size === 'sidebar' || size === 'minimal';
---

<section class={`newsletter newsletter--${size}`} aria-label="Newsletter signup">
  <div class="newsletter__inner">
    <span class="kicker">{finalKicker}</span>
    <h3 class="newsletter__heading">{finalHeading}</h3>
    <p class="newsletter__blurb">{cfg.blurb}</p>

    {isSidebar ? (
      <form
        class="newsletter__form-custom"
        action={NEWSLETTER.hostedSubscribeUrl}
        method="get"
        target="_blank"
        rel="noopener"
      >
        <label class="newsletter__label" for={`crux-email-${size}`}>Email address</label>
        <div class="newsletter__row">
          <input
            id={`crux-email-${size}`}
            type="email"
            name="email"
            placeholder="you@example.com"
            required
            class="newsletter__input"
            autocomplete="email"
          />
          <button type="submit" class="newsletter__submit">Subscribe</button>
        </div>
        <p class="newsletter__fineprint">
          Free. One click to unsubscribe.
        </p>
      </form>
    ) : (
      <div class="newsletter__form">
        <script
          is:inline
          async
          src="https://subscribe-forms.beehiiv.com/v3/loader.js"
          data-beehiiv-form={NEWSLETTER.embedFormId}
        ></script>
        <noscript>
          <p>
            <a href={NEWSLETTER.hostedSubscribeUrl} rel="noopener" target="_blank">
              Subscribe via thecruxco.beehiiv.com →
            </a>
          </p>
        </noscript>
        <p class="newsletter__fallback">
          Form not loading? <a href={NEWSLETTER.hostedSubscribeUrl} rel="noopener" target="_blank">Subscribe directly →</a>
        </p>
      </div>
    )}
  </div>
</section>
